# Environment (development | production | test)
NODE_ENV=development

# Server Port Settings
PORT=5000
API_PORT=5000

# Client URLs
CLIENT_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173

# Database Connection (Single-User Local Instance)
MONGODB_URI=mongodb://127.0.0.1:27017/sk_job_pilot

# Server Logging
LOG_LEVEL=info

# Client API Base URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Google Gemini API Settings (Backend Memory Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Resume File Storage & Ingestion
RESUME_STORAGE_DIR=./uploads/resumes
MAX_RESUME_FILE_SIZE_MB=10
